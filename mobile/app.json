{
  "expo": {
    "name": "PC TV Remote",
    "slug": "pc-tv-remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c111d",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pctvbox.remote",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan the TV pairing QR code.",
        "NSLocalNetworkUsageDescription": "This app needs local network access to communicate with your PC TV Box on your Wi-Fi."
      }
    },
    "android": {
      "package": "com.pctvbox.remote",
      "adaptiveIcon": {
        "backgroundColor": "#0c111d",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withLocalCaTrust",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c111d",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PC TV Remote to scan the QR code displayed on your TV.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
